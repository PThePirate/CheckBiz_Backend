# Para correr con `gradle bootRun` local (sin Docker para el backend,
# solo Postgres vía docker compose up db). Spring Boot lee estas variables
# automáticamente si las exportas en tu shell, o puedes pasarlas con
# -D o un plugin como spring-dotenv si prefieres un archivo .env real.

DATABASE_URL=jdbc:postgresql://localhost:5432/checkbiz_db
DATABASE_USER=postgres
DATABASE_PASSWORD=checkbiz_dev_pw

PORT=4000
JWT_SECRET=600452
JWT_EXPIRATION_MS=604800000
OTP_DEV_MODE=true
UPLOADS_DIR=uploads

# URL HTTPS pública y directa del logo; evita incluir imágenes adjuntas en el correo.
# Si se deja vacía, se mantiene el logo integrado por CID.
EMAIL_LOGO_URL=
